          "tipo": "Exe",
          "caminho": "\\\\SERVIDOR-EXEMPLO\\Instaladores$\\Fiscal\\SEFAZ\\PREENCHER.exe",
          "argumentos": "",
          "deteccao": { "tipo": "ProgramaInstalado", "nomeExibicao": "PREENCHER" }
        }
      ]
    },
    {
      "nome": "Contábil",
      "aplicativos": [
        {
          "nome": "EXEMPLO - Aplicativo do Contábil 1",
          "pendente": true,
          "motivoPendencia": "Exemplo: preencher com o programa real do departamento Contábil.",
          "tipo": "Exe",
          "caminho": "\\\\SERVIDOR-EXEMPLO\\Instaladores$\\Contabil\\PREENCHER.exe",
          "argumentos": "",
          "deteccao": { "tipo": "ProgramaInstalado", "nomeExibicao": "" }
        }
      ]
    },
    {
      "nome": "Departamento Pessoal",
      "aplicativos": [
        {
          "nome": "EXEMPLO - Aplicativo do Departamento Pessoal 1",
          "pendente": true,
          "motivoPendencia": "Exemplo: preencher com o programa real do Departamento Pessoal.",
