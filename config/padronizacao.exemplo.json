// =============================================================================
//  Padronizador de Estações - TI  |  Arquivo de configuração (EXEMPLO)
// -----------------------------------------------------------------------------
//  - Este arquivo aceita comentários (// ...) e vírgula no final das listas.
//  - Em caminhos do Windows, cada barra invertida deve ser escrita dobrada: "C:\\Pasta\\arquivo.msi"
//    Um caminho de rede \\SERVIDOR\Pasta fica assim: "\\\\SERVIDOR\\Pasta"
//  - Itens com "pendente": true aparecem no resumo, mas NUNCA são executados.
//  - Itens com configuração incompleta são tratados automaticamente como pendentes.
//  - Os nomes de servidor, pastas e programas abaixo são FICTÍCIOS. Substitua pelos reais
//    na cópia "padronizacao.json" (que não deve ser enviada ao GitHub).
//  - Não coloque senhas, chaves de licença ou tokens neste arquivo.
// =============================================================================
{
  // Pasta local onde fica um log por execução.
  "pastaLogs": "%ProgramData%\\PadronizadorTI\\Logs",

  // (Opcional) Pasta de rede para receber uma cópia de cada log. Deixe "" para não usar.
  // Exemplo: "\\\\SERVIDOR-EXEMPLO\\TI$\\PadronizadorTI\\Logs"
  "pastaLogsRede": "",

  // Fontes do WinGet aceitas. "winget" é o repositório oficial da Microsoft.
  // Não adicione fontes de terceiros desconhecidas.
  "fontesWinGetPermitidas": [ "winget" ],

  // ---------------------------------------------------------------------------
  //  Configurações comuns de energia (aplicadas a todos os departamentos)
  //  Minutos: 0 = Nunca | null = não alterar
  // ---------------------------------------------------------------------------
  "energia": {
    "aplicar": true,
    "ativarAltoDesempenho": true,

    // Ligado à tomada (AC)
    "tomada": {
      "desligarTelaMinutos": 0,
      "suspenderMinutos": 0,
      "hibernarMinutos": 0
    },

    // Na bateria (DC) - separado e NÃO aplicado automaticamente.
    // Só será aplicado se você mudar "aplicar" para true, conscientemente.
    "bateria": {
      "aplicar": false,
      "desligarTelaMinutos": 5,
      "suspenderMinutos": 15,
      "hibernarMinutos": 60
    }
  },

  // ---------------------------------------------------------------------------
  //  Aplicativos instalados em TODOS os departamentos
  // ---------------------------------------------------------------------------
  "aplicativosComuns": [
    {
      "nome": "WinRAR",
      "tipo": "WinGet",
      "idWinGet": "RARLab.WinRAR",
      "fonte": "winget",
      "deteccao": { "tipo": "ProgramaInstalado", "nomeExibicao": "WinRAR", "comparacao": "IniciaCom" },
      "observacao": "Uso comercial exige licença do WinRAR. A chave de licença NÃO é aplicada por este programa."
    },
    {
      "nome": "Antivírus corporativo",
      "pendente": true,
      "motivoPendencia": "PENDENTE: informar produto, versão, instalador (.msi/.exe) aprovado, argumentos silenciosos e regra de detecção. O Microsoft Defender não é desativado por este programa.",
      "tipo": "Msi",
      "caminho": "\\\\SERVIDOR-EXEMPLO\\Instaladores$\\Antivirus\\PREENCHER.msi",
      "argumentos": "",
      "sha256": "",
      "deteccao": { "tipo": "ProgramaInstalado", "nomeExibicao": "PREENCHER nome em Programas e Recursos" }
    },
    {
      "nome": "Java",
      "pendente": true,
      "motivoPendencia": "PENDENTE: informar distribuição (Oracle Java exige licença comercial; OpenJDK é alternativa), versão (ex.: 8, 17, 21), arquitetura (32/64 bits) e o instalador ou ID WinGet aprovado.",
      "tipo": "WinGet",
      "idWinGet": "",
      "versao": "",
      "deteccao": { "tipo": "ProgramaInstalado", "nomeExibicao": "PREENCHER" }
    }

    // ---- Modelos para copiar (remova o comentário e preencha) ----
    // {
    //   "nome": "EXEMPLO - Programa pelo WinGet",
    //   "tipo": "WinGet",
    //   "idWinGet": "Fornecedor.Programa",           // confira com: winget search "nome" --source winget
