          "tipo": "Exe",
          "caminho": "\\\\SERVIDOR-EXEMPLO\\Instaladores$\\Dominio\\PREENCHER.exe",
          "argumentos": "",
          "deteccao": { "tipo": "ProgramaInstalado", "nomeExibicao": "PREENCHER" }
